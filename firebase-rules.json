{
  "rules": {
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((!newData.exists() && data.val() === auth.uid) || (newData.isString() && (!data.exists() || data.val() === auth.uid)))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.child('id').val() === auth.uid"
      },
      ".read": "auth != null"
    },
    "friend_requests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || newData.child(auth.uid).exists())"
      }
    },
    "friend_sent": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('friend_requests').child(auth.uid).child($uid).exists()))"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists() || root.child('friend_requests').child(auth.uid).child($uid).exists())"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.child('id').val() === auth.uid"
      }
    },
    "room_invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$room": {
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['room','code','fromId','fromName','ts']) && newData.child('room').val() === $room"
        }
      }
    }
  }
}
